# Claude API
ANTHROPIC_API_KEY=
# Overrides the production default (claude-sonnet-5). Set to claude-opus-4-8 ONLY for
# the M2 classifier tuning pass — never ship that as the production default.
ANTHROPIC_MODEL=claude-sonnet-5

# GitHub App auth (preferred, M3) — installation-token auth scoped to Contents + Pull
# requests only (Metadata is mandatory/read-only). GITHUB_PRIVATE_KEY is the raw .pem
# contents from the App's "Generate a private key" button, wrapped in double quotes so
# dotenv parses the embedded newlines as one multi-line value:
#   GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
#   ...
#   -----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALLATION_ID comes from the URL after installing the App on a repo:
# github.com/settings/installations/<ID>. All three are all-or-nothing — set together.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# GitHub — legacy personal-access-token auth (repo scope). Used only if the GitHub App
# vars above are unset. Broader scope than council Condition 1 allows for production —
# fine for local dev/testing, not for the shipped GitHub App.
GITHUB_TOKEN=

# Webhook — HMAC secret shared with the GitHub App/webhook config. Every inbound
# payload must be verified against this before the pipeline runs.
GITHUB_WEBHOOK_SECRET=

# Durable idempotency store (M3) — a Postgres connection string (Neon, Supabase, RDS, local,
# any standard Postgres). Required before running Verlio as more than one instance or on
# serverless: without it, the webhook falls back to an in-memory store that loses all state on
# restart and can't be shared across instances, which lets GitHub's retries duplicate work.
DATABASE_URL=

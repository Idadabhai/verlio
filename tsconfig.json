{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["lib/**/*.ts", "pipeline/**/*.ts", "webhook/**/*.ts", "cli/**/*.ts", "mcp/**/*.ts", "corpus/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
